<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xiamen Gaoqi Airport Guide</title>
    <style>
        :root {
            --primary: #2a4365;
            --secondary: #3182ce;
            --accent: #e53e3e;
            --light: #f7fafc;
            --gray: #e2e8f0;
            --dark: #1a202c;
            --border-radius: 10px;
            --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        
        body {
            background-color: var(--light);
            color: var(--dark);
            line-height: 1.6;
            padding: 2rem;
        }
        
        .container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
            align-items: stretch; /* Ensure equal height */
        }
        
        /* Original Left Card Style */
        .airport-card {
            background: white;
            border-radius: var(--border-radius);
            padding: 2rem;
            box-shadow: var(--box-shadow);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%; /* Ensure equal height */
            display: flex;
            flex-direction: column;
        }
        
        .airport-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
        }
        
        .airport-header {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
        }
        
        .airport-icon {
            font-size: 2rem;
            margin-right: 1rem;
            color: var(--secondary);
        }
        
        .airport-title {
            color: var(--primary);
            font-size: 1.5rem;
            margin: 0;
        }
        
        .airport-subtitle {
            color: var(--dark);
            opacity: 0.8;
            font-size: 1rem;
            margin-top: 0.25rem;
        }
        
        .feature-list {
            list-style: none;
            margin-top: 1.5rem;
            flex-grow: 1; /* Ensure equal height */
        }
        
        .feature-list li {
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--gray);
            display: flex;
            align-items: center;
        }
        
        .feature-list li:last-child {
            border-bottom: none;
        }
        
        .feature-icon {
            color: var(--accent);
            margin-right: 1rem;
            font-size: 1.5rem;
            min-width: 30px;
            text-align: center;
        }
        
        .feature-text {
            display: flex;
            flex-direction: column;
        }
        
        .feature-label {
            color: var(--primary);
        }
        
        /* Right Card - Airlines (Styled to match) */
        .airlines-card {
            background: white;
            border-radius: var(--border-radius);
            padding: 2rem;
            box-shadow: var(--box-shadow);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%; /* Ensure equal height */
            display: flex;
            flex-direction: column;
        }
        
        .airlines-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
        }
        
        .airlines-header {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
        }
        
        .airlines-icon {
            font-size: 2rem;
            margin-right: 1rem;
            color: var(--secondary);
        }
        
        .airlines-title {
            color: var(--primary);
            font-size: 1.5rem;
            margin: 0;
        }
        
        .airlines-container {
            max-height: 400px;
            overflow-y: auto;
            padding-right: 10px;
            flex-grow: 1; /* Ensure equal height */
            margin-top: 1rem;
        }
        
        .airline-group {
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--gray);
        }
        
        .airline-group:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }
        
        .airline-name {
            color: var(--primary);
            margin-bottom: 8px;
            font-size: 1rem;
            display: flex;
            align-items: center;
        }
        
        .airline-name::before {
            content: "✈";
            margin-right: 8px;
            color: var(--accent);
        }
        
        .destinations {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }
        
        .destination-tag {
            background: rgba(234, 242, 253, 0.8);
            color: var(--primary);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            border: 1px solid rgba(26, 115, 232, 0.1);
        }
        
        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }
            
            .container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Original Left Card -->
        <div class="airport-card">
            <div class="airport-header">
                <span class="airport-icon">✈️</span>
                <div>
