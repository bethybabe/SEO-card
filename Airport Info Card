                        <span class="destination-tag">Nanjing</span>
                        <span class="destination-tag">Shanghai</span>
                        <span class="destination-tag">Taiyuan</span>
                        <span class="destination-tag">Wuhan</span>
                        <span class="destination-tag">Xi'an</span>
                    </div>
                </div>
                
                <div class="airline-group">
                    <div class="airline-name">Air China</div>
                    <div class="destinations">
                        <span class="destination-tag">Beijing</span>
                        <span class="destination-tag">Chengdu</span>
                        <span class="destination-tag">Chongqing</span>
                        <span class="destination-tag">Guiyang</span>
                        <span class="destination-tag">Tianjin</span>
                        <span class="destination-tag">Wuhan</span>
