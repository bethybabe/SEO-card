                        <span class="destination-tag">Sydney</span>
                        <span class="destination-tag">Tokyo</span>
                        <span class="destination-tag">Vancouver</span>
                        <span class="destination-tag">+40 more</span>
                    </div>
                </div>
                
                <div class="airline-group">
                    <div class="airline-name">China Eastern</div>
                    <div class="destinations">
                        <span class="destination-tag">Beijing</span>
                        <span class="destination-tag">Changchun</span>
