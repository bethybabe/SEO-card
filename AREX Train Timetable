    <style>
        :root {
            --primary: #3a7bd5;
            --primary-light: #f1f7ff;
            --primary-gradient: linear-gradient(135deg, #3a7bd5, #00d2ff);
            --text: #2c3e50;
            --text-light: #7f8c8d;
            --white: #ffffff;
            --gray-light: #f8f9fa;
            --gray: #ecf0f1;
            --shadow: 0 4px 16px rgba(0,0,0,0.08);
            --shadow-small: 0 2px 8px rgba(0,0,0,0.05);
            --radius: 12px;
            --border: 1px solid #eaeaea;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background-color: var(--white);
            color: var(--text);
            line-height: 1.5;
            padding: 20px;
        }
        
        .container {
            max-width: 720px;
            margin: 0 auto;
            padding: 10px;
        }
        
        /* Tab system based on the working example */
        .tabs {
            background: var(--white);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: 20px;
            position: relative;
        }
        
        /* Hide radio buttons */
        .tab-control {
            position: absolute;
            opacity: 0;
            z-index: -1;
        }
        
        /* Tab header */
        .tab-header {
            display: flex;
            background: var(--primary-gradient);
        }
        
        .tab-label {
            padding: 15px 0;
            flex: 1;
            color: white;
            text-align: center;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.3s ease;
            opacity: 0.7;
        }
        
        .tab-label:hover {
            opacity: 0.9;
        }
        
        /* Active tab styles */
        #tab1:checked ~ .tab-header .tab1-label,
        #tab2:checked ~ .tab-header .tab2-label {
            opacity: 1;
            background: rgba(255, 255, 255, 0.1);
            box-shadow: inset 0 -3px 0 white;
        }
        
        /* Tab content section */
        .tab-content {
            position: relative;
        }
        
        .tab-pane {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        /* Show selected tab */
        #tab1:checked ~ .tab-content .tab-pane1,
        #tab2:checked ~ .tab-content .tab-pane2 {
            display: block;
        }
        
        /* Direction info */
        .direction-info {
            display: flex;
            align-items: center;
            padding: 16px 20px;
            background: var(--primary-light);
            border-bottom: var(--border);
            font-weight: 500;
            color: var(--primary);
        }
        
        .direction-info svg {
            margin-right: 10px;
        }
        
        /* Table styles */
        .table-wrapper {
            max-height: 370px;
            overflow-y: auto;
            position: relative;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }
        
        thead {
            position: sticky;
            top: 0;
            z-index: 10;
            background: var(--white);
        }
        
        th {
            font-weight: 600;
            color: var(--text);
            background: var(--white);
            padding: 16px 12px;
            text-align: center;
            border-bottom: 2px solid var(--primary);
        }
        
        td {
            padding: 12px;
            text-align: center;
            border-bottom: var(--border);
        }
        
        tr:nth-child(even) {
            background-color: var(--gray-light);
        }
        
        tr:hover {
            background-color: var(--primary-light);
        }
        
        /* Scroll indicator */
        .scroll-info {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px;
            font-size: 0.8rem;
            color: var(--text-light);
            background: var(--white);
            border-top: var(--border);
        }
        
        .scroll-info svg {
            margin-left: 6px;
        }
        
        /* Footer */
        .footer {
            text-align: center;
            padding: 12px;
            font-size: 0.8rem;
            color: var(--text-light);
            margin-top: 10px;
        }
        
        /* Responsive */
        @media (max-width: 600px) {
            body {
                padding: 10px;
            }
            
            .container {
                padding: 0;
            }
            
            .tab-label {
                padding: 12px 0;
                font-size: 0.85rem;
            }
            
            th, td {
                padding: 10px 6px;
                font-size: 0.85rem;
            }
        }
    </style>
</head>
